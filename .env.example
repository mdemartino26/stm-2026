# Copiá este archivo como ".env" y completalo. El archivo ".env" NO se sube a GitHub.

# Client ID de tu app en https://developer.spotify.com/dashboard (no es secreto)
VITE_SPOTIFY_CLIENT_ID=

# API key de Last.fm: https://www.last.fm/api/account/create (solo hace falta la "API key")
VITE_LASTFM_API_KEY=

# Usuario público de Last.fm que se carga en el modo demo (quien visite el sitio sin cuenta lo ve).
# Poné el tuyo si querés mostrar tu propia música en el portfolio.
VITE_DEMO_LASTFM_USER=rj

# Opcional. Si no la definís, se usa  <origen del sitio>/callback
# Tiene que coincidir EXACTO con una Redirect URI registrada en el dashboard de Spotify.
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
